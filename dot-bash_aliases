# ls
alias l="ls -lh"
alias ll="ls -alh"
alias la="ll"

# Python
alias on="activate"
alias off="deactivate"
alias pyv="python --version"
alias py="python"
alias py3="python3"

# Git
alias lg="lazygit"
alias g="git"
alias gi="g"
alias gs="g status"
alias gp="g pull"
alias ga="g add"
alias gc="git commit"
alias gss="git stash"
alias gsu="git stash --include-untracked"
alias gsp="git stash pop"

# Generic
alias clr="clear"
alias dop="xdg-open ."
alias doc="docker"
alias docom="docker compose"
alias fix-dual-boot-time="timedatectl set-local-rtc 1 --adjust-system-clock"
alias unfix-dual-boot-time="timedatectl set-local-rtc 0 --adjust-system-clock"

# Load machine-specific aliases
if [ -f ~/.bash_aliases.local ]; then
    . ~/.bash_aliases.local
fi
