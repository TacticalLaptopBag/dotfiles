# Activate a venv inside cwd. First argument is the path to the venv. If not supplied, '.venv' is used
function activate () {
    if [[ -z "$1" ]]; then
        VENV_NAME=".venv"
    else
        VENV_NAME="$1"
    fi

    source "$VENV_NAME/bin/activate"
}

# Create venv. First argument is the venv name. If not supplied, '.venv' is used
function venv () {
    if [[ -z "$1" ]]; then
        VENV_NAME=".venv"
    else
        VENV_NAME="$1"
    fi

    python3 -m venv $VENV_NAME
}

