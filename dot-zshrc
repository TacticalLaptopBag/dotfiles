if [ "$ZSH_THEME" = "agnoster" ]; then
  prompt_newline() {
      echo -n " %K{default}%F{$CURRENT_BG}"
      echo -n $'\ue0b0'
      echo "%k%f"
      CURRENT_BG="NONE"
  }
  
  prompt_context() {
    prompt_segment 235 13 "%D{%Y-%m-%d %H:%M:%S}"
    local context="$USER@$(hostname)"
    local branch="$(g rev-parse --abbrev-ref -q HEAD 2> /dev/null)"
    local cwd="$(pwd)"
    if [ -z "$BRANCH" ]; then
      cwd="$cwd$branch"
    fi
    local prompt_context="%(!.%{%F{yellow}%}.)%n@%m"
    # TODO: Should also add the length of the git branch to the length of cwd, if any
    if [[ "$USERNAME" != "$DEFAULT_USER" || -n "$SSH_CLIENT" ]]; then
      if [ $(( ${#cwd} - ${#HOME} )) -ge $(( ${#context} + (${#context} / 2) )) ]; then
        prompt_segment gray default "$prompt_context"
        prompt_newline
      else
        prompt_segment black default "$prompt_context"
      fi
    fi
  }
elif [ "$ZSH_THEME" = "bureau" ]; then
  BUREAU_PROMPT="$PROMPT"
  _inject_exit_status() {
    local status_indicator=""

    if [[ $RETVAL -ne 0 ]]; then
      status_indicator="%{%F{red}%}✘%{%f%} "
    fi
   #else
   #  status_indicator="%{%F{green}%}✓%{%f%}"
   #fi

    local venv_info=""
    if [[ -n "$VIRTUAL_ENV" ]]; then
      venv_info="%{%F{cyan}%}(${VIRTUAL_ENV:t})%{%f%} "
    fi

    PROMPT="${status_indicator}${venv_info}${BUREAU_PROMPT}"
  }
  add-zsh-hook precmd _inject_exit_status

  # I don't want the nvm version
  nvm_prompt_info() {
