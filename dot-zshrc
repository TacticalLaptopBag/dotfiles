# Capture previous command return code in RETVAL
_capture_return_code() { export RETVAL=$? }
add-zsh-hook precmd _capture_return_code

# Customize cursor in terminals that support it
# '\e[1 q': Blinking block
# '\e[2 q': Steady block
# '\e[3 q': Blinking underline
# '\e[4 q': Steady underline
# '\e[5 q': Blinking beam
# '\e[6 q': Steady beam
_fix_cursor() { echo -ne '\e[1 q' }
add-zsh-hook precmd _fix_cursor

